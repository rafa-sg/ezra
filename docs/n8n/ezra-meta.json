    {
      "id": "2",
      "name": "Validar y preparar",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [240, 0],
      "parameters": {
        "jsCode": "\nconst b = $json.body;\nconst error = (mensaje) => [{json:{valido:false,mensaje}}];\nif (!b || typeof b.id_solicitud !== 'string' || !b.id_solicitud.trim() || b.id_solicitud.length > 100) return error('Falta id_solicitud.');\nif (b.accion === 'probar_conexion') return [{json:{valido:true,prueba:true,id:b.id_solicitud}}];\nif (b.accion !== 'meta_solicitud') return error('Acción no permitida.');\nconst s = b.solicitud;\nif (!s || typeof s.url !== 'string' || !/^https:\\/\\/(graph\\.facebook\\.com|graph-video\\.facebook\\.com|graph\\.instagram\\.com|rupload\\.facebook\\.com)\\//.test(s.url) || /[\\s\\\\\\r\\n]/.test(s.url)) return error('Destino de Meta no permitido.');\nif (!['GET','POST'].includes(s.metodo)) return error('Método no permitido.');\nif (typeof s.cuerpoBase64 !== 'string' || s.cuerpoBase64.length > 11184812 || !/^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$/.test(s.cuerpoBase64)) return error('Cuerpo inválido o mayor a 8 MB.');\nif (!s.cabeceras || typeof s.cabeceras !== 'object' || Array.isArray(s.cabeceras)) return error('Cabeceras inválidas.');\nconst cabeceras = {};\nfor (const [k,v] of Object.entries(s.cabeceras)) {\n  if (!['authorization','content-type','offset','file_size'].includes(k.toLowerCase()) || typeof v !== 'string' || /[\\r\\n]/.test(v)) return error('Cabecera no permitida.');\n  cabeceras[k.toLowerCase()] = v;\n}\nconst item = {json:{valido:true,prueba:false,id:b.id_solicitud,url:s.url,metodo:s.metodo,cabeceras,conCuerpo:s.metodo === 'POST'}};\nif (s.metodo === 'POST') item.binary = {carga:await this.helpers.prepareBinaryData(Buffer.from(s.cuerpoBase64,'base64'),'carga',cabeceras['content-type'] || 'application/octet-stream')};\nreturn [item];\n"
      }
    },
