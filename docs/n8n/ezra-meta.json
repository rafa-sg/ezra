      "id": "1",
      "name": "Recibir solicitud de Ezra",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0],
      "parameters": {
        "httpMethod": "POST",
        "path": "ezra-publicaciones",
