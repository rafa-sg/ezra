{
  "name": "ezra-spotmi",
  "version": "0.1.0",
  "private": true,
  "description": "Panel comercial para Sgmotos y motoxspress · ezrá",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "dev:docker": "next dev --hostname 0.0.0.0 --port 3000",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"tests/*.test.ts\"",
    "check": "npm run lint && npm run typecheck && npm test",
    "test:integration": "node --import tsx --test \"tests/integration/*.test.ts\"",
    "access:owner": "node --env-file-if-exists=.env.local --import tsx scripts/configure-owner.ts",
    "granjas:trabajador": "node --env-file-if-exists=.env.local --env-file-if-exists=.env.meta.local --import tsx scripts/granjas-trabajador.ts",
    "eventos:importar": "node --env-file-if-exists=.env.local --import tsx scripts/eventos-importar.ts",
    "eventos:imagenes": "node --env-file-if-exists=.env.local --import tsx scripts/eventos-imagenes.ts",
    "format": "prettier --write .",
    "demo:datos": "node --import tsx scripts/datos-demo.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@clerk/localizations": "^4.21.2",
    "@clerk/nextjs": "^7.9.10",
    "@google/genai": "^2.27.0",
    "jszip": "^3.10.2",
    "lucide-react": "^1.52.0",
    "next": "^16.4.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0"
  }
}
