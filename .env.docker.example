# Copia este archivo a .env.docker (Git y Docker lo ignoran) y completa SOLO tus claves de desarrollo.
# Nunca pongas aquí claves de producción, contraseñas personales ni tokens de redes.

# Clerk (inicio de sesión). Crea tu propia aplicación gratuita en https://dashboard.clerk.com,
# en modo Development, y copia sus claves de «API keys». Empiezan con pk_test_ y sk_test_.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_reemplazar
CLERK_SECRET_KEY=sk_test_reemplazar

# Rutas de acceso de Ezra (no cambiar).
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# Lectura pública del sitio de Spotmi (opcional, sin clave).
SPOTMI_SITE_URL=https://spotmi.com.sv

# El trabajador, la IA de pago y la publicación en redes están apagados en compose.yaml.
