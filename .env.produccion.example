# Copia este archivo a .env.produccion EN EL SERVIDOR (Git y Docker lo ignoran) y completa los valores.
# Nunca lo subas a GitHub ni lo pegues en un chat.

# Dirección pública de Ezra (debe apuntar a la IP del servidor con un registro A en DonDominio).
EZRA_DOMINIO=ezra.spotmi.com.sv
# Ezra solo responde en estos dominios (además de localhost). Mismo valor que arriba.
EZRA_DOMINIOS=ezra.spotmi.com.sv

# Clerk de PRODUCCIÓN (empiezan con pk_live_ y sk_live_). La instancia de desarrollo no sirve aquí.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_reemplazar
CLERK_SECRET_KEY=sk_live_reemplazar
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# Cifrado de tokens de redes: copia el MISMO valor de tu .env.local, o los tokens guardados no se podrán leer.
EZRA_TOKEN_KEY=

# Gemini (opcional) y su modelo.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite
EZRA_PRODUCCION_IA=0

# Regreso de OAuth de Instagram, Facebook, TikTok y YouTube: registra esta dirección en cada app.
EZRA_OAUTH_REDIRECT_BASE=https://ezra.spotmi.com.sv

# Trabajador y horarios de las granjas (las de las 04:30) corren en el servidor.
EZRA_GRANJAS_TRABAJADOR=1
# EZRA_GRANJAS_CONCURRENCIA=2

# Spotmi web.
SPOTMI_SITE_URL=https://spotmi.com.sv
SPOTMI_SUPABASE_URL=
SPOTMI_SUPABASE_ANON_KEY=

# Redes (copiar de .env.local solo las que uses).
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
META_APP_ID=
META_APP_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
