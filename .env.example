# El piloto funciona sin claves ni servicios de pago.
# Opcional: directorio ABSOLUTO distinto para datos de pruebas.
# EZRA_DATA_DIR=/ruta/absoluta/a/datos-de-prueba

# Automatización local con n8n (fase simulada). Copia estas líneas a .env.local
# y pon valores reales SOLO allí. Cada secreto: mínimo 32 caracteres y distintos
# entre sí; si falta uno, los endpoints de automatización rechazan todo.
# La dirección debe ser local (127.0.0.1 o localhost). Con Docker, publica n8n con
# -p 127.0.0.1:5678:5678 y que n8n responda a http://host.docker.internal:3000/api/automation/results
# N8N_WEBHOOK_URL=http://127.0.0.1:5678/webhook/ezra-prueba
# Flujo «buscar ideas» (docs/n8n/ezra-buscar-ideas.json), también solo local:
# N8N_IDEAS_WEBHOOK_URL=http://127.0.0.1:5678/webhook/ezra-ideas
# Flujo «generar propuesta» con Gemini (docs/n8n/ezra-generar-propuesta.json).
# Para este flujo de n8n, la clave de Gemini va en una credencial de n8n.
# N8N_DRAFT_WEBHOOK_URL=http://127.0.0.1:5678/webhook/ezra-propuesta
# EZRA_TO_N8N_SECRET=
# N8N_TO_EZRA_SECRET=

# «Pregúntale a la IA» (Gemini, solo del lado del servidor). Pon la clave SOLO en
# .env.local (ignorado por Git); nunca en variables NEXT_PUBLIC_*. Reinicia el servidor.
# GEMINI_API_KEY=
# Opcional; por defecto gemini-3.5-flash-lite (Flash-Lite estable, verificado el 2026-10-07).
# GEMINI_MODEL=gemini-3.5-flash-lite

# Estudio Spotmi: lectura pública, sin service role ni sesión de Supabase.
SPOTMI_SITE_URL=https://spotmi.com.sv
SPOTMI_SUPABASE_URL=
SPOTMI_SUPABASE_ANON_KEY=
# La generación Gemini del estudio solo se habilita con una decisión explícita.
EZRA_PRODUCCION_IA=0
# Opcionales, si no se detectan las herramientas locales por PATH.
EZRA_CODEX_BIN=
EZRA_CLAUDE_BIN=

# Granjas Spotmi (27 oct 2026). Valores SOLO en .env.local; nunca en el chat ni en NEXT_PUBLIC_*.
# Clave del servidor para cifrar tokens (32 bytes en base64). Generar con: openssl rand -base64 32
EZRA_TOKEN_KEY=
# Base de las direcciones de regreso OAuth. Instagram y TikTok exigen https registrado en su app.
# EZRA_OAUTH_REDIRECT_BASE=http://127.0.0.1:3000
# Instagram API con inicio de sesión de Instagram (cuenta profesional).
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Facebook Login para Páginas (pages_show_list, pages_read_engagement, pages_manage_posts).
META_APP_ID=
META_APP_SECRET=
# Versión de Graph API (comprobada en la documentación de Páginas el 27 oct 2026).
# META_GRAPH_VERSION=v26.0
# TikTok: solo borradores con video.upload; la publicación directa no aplica a herramientas internas.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# TikTok exige https: usa el puente de n8n (agrega «Regreso tiktok» de docs/n8n/ezra-meta.json).
# TIKTOK_REDIRECT_URI=https://spotmi.app.n8n.cloud/webhook/ezra-oauth-tiktok
# YouTube Data API v3 (Google Cloud · ID de cliente OAuth «Aplicación web»). Solo lectura del canal y
# subida en privado; la dirección de regreso es http://127.0.0.1:3000/conexiones/youtube/callback.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# Spotmi web: cuenta editorial de Supabase habilitada por un founder (migración 20261103 aplicada).
SPOTMI_EDITORIAL_EMAIL=
SPOTMI_EDITORIAL_PASSWORD=
# Trabajador local: 0 lo apaga en el servidor (usar entonces `npm run granjas:trabajador`).
# EZRA_GRANJAS_TRABAJADOR=1
# EZRA_GRANJAS_CONCURRENCIA=2
# Opcional si ffmpeg/ffprobe no están en /opt/homebrew/bin, /usr/local/bin o /usr/bin.
# EZRA_FFMPEG_BIN=
# EZRA_FFPROBE_BIN=
# Verificación sin pisar el servidor de desarrollo: EZRA_DIST_DIR=.next-verificar npm run build
# EZRA_DIST_DIR=.next
